<div class="page-head">
  <h1>Sources</h1>
</div>
<p class="muted">Every fact the assistant states comes from one of these passages, and each answer links to its source. If a question isn't covered here, the assistant says so instead of guessing.</p>

<% sources.forEach(s => { %>
  <section class="section card source-card" id="<%= s.id %>">
    <h2><%= s.title %></h2>
    <p class="small muted">
      <%= s.publisher %> ·
      <a href="<%= s.url %>" target="_blank" rel="noopener"><%= s.url %></a> ·
      last checked <%= s.lastChecked %>
    </p>
    <dl class="source-passages">
      <% s.passages.forEach(p => { %>
        <dt id="<%= p.id %>"><%= p.heading %> <span class="muted small">(<%= p.id %>)</span></dt>
        <dd><%= p.text %></dd>
      <% }) %>
    </dl>
  </section>
<% }) %>
